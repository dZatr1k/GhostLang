<UserControl x:Class="GhostLang.WPF.Controls.LanguageMultiSelect"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        
        <ToggleButton x:Name="DropdownToggle"
                      HorizontalAlignment="Stretch"
                      Checked="DropdownToggle_Checked"
                      Unchecked="DropdownToggle_Unchecked">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="6,4" MinHeight="28" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding SummaryText, ElementName=Root}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SummaryText, ElementName=Root}" />

                            <Path Grid.Column="1"
                                  Data="M7,10L12,15L17,10H7Z"
                                  Fill="{DynamicResource ThirdlyTextBrush}"
                                  Width="10" Height="10" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="DropdownPopup"
               PlacementTarget="{Binding ElementName=DropdownToggle}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide"
               Closed="DropdownPopup_Closed">
            <Border Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="4" Margin="0,2,0,0"
                    MinWidth="{Binding ActualWidth, ElementName=DropdownToggle}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <ItemsControl x:Name="CheckboxList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="4,3" FontSize="12"
                                      Checked="CheckBox_Changed"
                                      Unchecked="CheckBox_Changed" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</UserControl>