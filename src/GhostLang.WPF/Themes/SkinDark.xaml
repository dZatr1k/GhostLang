<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryColor">#4ea8de</Color>
    <Color x:Key="DarkPrimaryColor">#2c6e9c</Color>
    <Color x:Key="DangerColor">#E74856</Color>
    <Color x:Key="DarkDangerColor">#C42D38</Color>
    <Color x:Key="WarningColor">#F5BF42</Color>
    <Color x:Key="DarkWarningColor">#D4A018</Color>
    <Color x:Key="InfoColor">#8bd0f2</Color>
    <Color x:Key="DarkInfoColor">#6BC0E8</Color>
    <Color x:Key="SuccessColor">#3CC25A</Color>
    <Color x:Key="DarkSuccessColor">#28A745</Color>

    <Color x:Key="PrimaryTextColor">#e5e5e5</Color>
    <Color x:Key="SecondaryTextColor">#AAAAAA</Color>
    <Color x:Key="ThirdlyTextColor">#777777</Color>
    <Color x:Key="ReverseTextColor">#FFFFFF</Color>
    <Color x:Key="TextIconColor">#e5e5e5</Color>

    <Color x:Key="BorderColor">#3f3f46</Color>
    <Color x:Key="SecondaryBorderColor">#4A4A52</Color>

    <Color x:Key="RegionColor">#1e1e1e</Color>
    <Color x:Key="SecondaryRegionColor">#252526</Color>
    <Color x:Key="ThirdlyRegionColor">#2D2D30</Color>
    <Color x:Key="TitleColor">#1e1e1e</Color>
    <Color x:Key="DefaultColor">#2D2D30</Color>

    <Color x:Key="DarkMaskColor">#10FFFFFF</Color>
    <Color x:Key="DarkOpacityColor">#40FFFFFF</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{StaticResource DarkPrimaryColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DarkDangerBrush" Color="{StaticResource DarkDangerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DarkWarningBrush" Color="{StaticResource DarkWarningColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="DarkInfoBrush" Color="{StaticResource DarkInfoColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DarkSuccessBrush" Color="{StaticResource DarkSuccessColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="{StaticResource ThirdlyTextColor}" />
    <SolidColorBrush x:Key="ReverseTextBrush" Color="{StaticResource ReverseTextColor}" />
    <SolidColorBrush x:Key="TextIconBrush" Color="{StaticResource TextIconColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="{StaticResource SecondaryBorderColor}" />

    <SolidColorBrush x:Key="RegionBrush" Color="{StaticResource RegionColor}" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{StaticResource SecondaryRegionColor}" />
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="{StaticResource ThirdlyRegionColor}" />
    <SolidColorBrush x:Key="TitleBrush" Color="{StaticResource TitleColor}" />
    <SolidColorBrush x:Key="DefaultBrush" Color="{StaticResource DefaultColor}" />

    <SolidColorBrush x:Key="DarkMaskBrush" Color="{StaticResource DarkMaskColor}" />
    <SolidColorBrush x:Key="DarkOpacityBrush" Color="{StaticResource DarkOpacityColor}" />

    <SolidColorBrush x:Key="InfoTextBrush" Color="#3f3f3e" />
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />
    <Color x:Key="WhiteColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="MandatoryStepBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="DisabledStepBrush" Color="#444449" />
</ResourceDictionary>