<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol">

    <!-- Override HC button styles to force white text -->
    <Style x:Key="ButtonPrimary" TargetType="Button" BasedOn="{StaticResource ButtonPrimary.Small}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="15,6" />
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
    </Style>

    <Style x:Key="ButtonDanger" TargetType="Button" BasedOn="{StaticResource ButtonDanger.Small}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="15,6" />
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
    </Style>

    <Style x:Key="ButtonSuccess" TargetType="Button" BasedOn="{StaticResource ButtonSuccess.Small}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="15,6" />
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}" />
    </Style>
</ResourceDictionary>