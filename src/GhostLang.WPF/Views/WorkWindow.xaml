<Window x:Class="GhostLang.WPF.Views.WorkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:svc="clr-namespace:GhostLang.WPF.Services"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource RegionBrush}" CornerRadius="6,6,0,0"
                Opacity="0.95" MouseLeftButtonDown="Toolbar_MouseLeftButtonDown">
            <DockPanel Margin="8,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="StartButton" Click="StartButton_Click"
                            Style="{StaticResource ButtonPrimary}"
                            Width="80" Height="26" FontSize="12" Margin="0,0,4,0" Padding="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M8,5V19L19,12L8,5Z" Fill="White"
                                  Width="10" Height="10" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{svc:Localize Work_Start}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Click="StopButton_Click"
                            Width="80" Height="26" FontSize="12" IsEnabled="False" Padding="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M6,6H18V18H6V6Z" Fill="{DynamicResource PrimaryTextBrush}"
                                  Width="10" Height="10" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{svc:Localize Work_Stop}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Content="✕" Click="CloseButton_Click" DockPanel.Dock="Right"
                        Style="{StaticResource ButtonDanger}"
                        Width="26" Height="26" FontSize="14" Padding="0"
                        HorizontalAlignment="Right" />

                <Button x:Name="OverflowButton" Click="OverflowButton_Click" DockPanel.Dock="Right"
                        Width="26" Height="26" FontSize="16" FontWeight="Bold"
                        HorizontalAlignment="Right" Margin="0,0,4,0"
                        Padding="0" Content="⋮">
                    <Button.ToolTip>
                        <ToolTip x:Name="OverflowTooltip" Placement="Top"
                                 Content="{Binding [Work_MoreMenu], Source={x:Static svc:LocalizationService.Instance}}" />
                    </Button.ToolTip>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="OverflowMenu" Placement="Top">
                            <MenuItem x:Name="CopyMenuItem"
                                      Header="{Binding [Work_Copy], Source={x:Static svc:LocalizationService.Instance}}"
                                      Click="Copy_Click" />
                            <MenuItem x:Name="SaveFrameMenuItem"
                                      Header="{Binding [Work_SaveFrame], Source={x:Static svc:LocalizationService.Instance}}"
                                      Click="SaveFrame_Click" />
                            <MenuItem x:Name="RefreshMenuItem"
                                      Header="{Binding [Work_Refresh], Source={x:Static svc:LocalizationService.Instance}}"
                                      Click="Refresh_Click" />
                            <Separator />
                            <MenuItem x:Name="SwitchLangMenuItem"
                                      Header="{Binding [Work_SwitchLanguage], Source={x:Static svc:LocalizationService.Instance}}" />
                            <MenuItem x:Name="ToggleOriginalMenuItem" IsCheckable="True"
                                      Header="{Binding [Work_ToggleOriginal], Source={x:Static svc:LocalizationService.Instance}}"
                                      Click="ToggleOriginal_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <TextBlock x:Name="StatusLabel" Text="{svc:Localize Work_Stopped}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="11" FontFamily="Consolas" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2"
                CornerRadius="0,0,6,6" Opacity="0.7"
                IsHitTestVisible="False" />
    </Grid>
</Window>
