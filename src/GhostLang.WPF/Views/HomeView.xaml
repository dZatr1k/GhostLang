<UserControl x:Class="GhostLang.WPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:svc="clr-namespace:GhostLang.WPF.Services"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="720">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <svgc:SvgViewbox x:Name="LogoImage" Source="/Assets/logo-full-black-theme.svg"
                             Width="180" Height="160" />
            <TextBlock Text="{svc:Localize Home_Subtitle}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="{StaticResource FontSizeBody}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{svc:Localize Home_TranslateFrom}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0"
                       FontSize="{StaticResource FontSizeControl}" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding SourceLanguages}"
                      SelectedItem="{Binding SelectedSourceLanguage}"
                      Height="32" />
            <TextBlock Grid.Column="4" Text="{svc:Localize Home_TranslateTo}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0"
                       FontSize="{StaticResource FontSizeControl}" />
            <ComboBox Grid.Column="5" ItemsSource="{Binding TargetLanguages}"
                      SelectedItem="{Binding SelectedTargetLanguage}"
                      Height="32" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">

                <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="{StaticResource RadiusCard}"
                        Effect="{StaticResource EffectShadow2}" />

                <Border Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource SpacingXl}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                            <Path Data="M21,2H3A2,2 0 0,0 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4A2,2 0 0,0 21,2M21,16H3V4H21"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  Width="22" Height="22" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{svc:Localize Home_ScreenTranslation}"
                                       FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="{Binding ScreenStatusText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />

                        <Button Grid.Row="2" Content="{svc:Localize Home_SelectRegion}"
                                Command="{Binding SelectScreenRegionCommand}"
                                Style="{StaticResource ButtonPrimary}"
                                Height="38" FontSize="14" HorizontalAlignment="Stretch" />

                        <StackPanel Grid.Row="3" Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScreenValidationIssues.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ItemsControl ItemsSource="{Binding ScreenValidationIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <Path DockPanel.Dock="Left"
                                                  Data="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"
                                                  Fill="{DynamicResource DangerBrush}"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  VerticalAlignment="Top" Margin="0,2,8,0" />
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       TextWrapping="Wrap" FontSize="12" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{svc:Localize Validation_OpenSettings}"
                                    Command="{Binding OpenSettingsFromValidationCommand}"
                                    CommandParameter="screen"
                                    Height="28" FontSize="12" HorizontalAlignment="Stretch"
                                    Margin="0,4,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Text="{Binding SelectRegionHotKeyHint}"
                                   Foreground="{DynamicResource ThirdlyTextBrush}"
                                   FontSize="11" HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2">

                <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="{StaticResource RadiusCard}"
                        Effect="{StaticResource EffectShadow2}" />

                <Border Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="{StaticResource RadiusCard}" Padding="{StaticResource SpacingXl}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                            <Path Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"
                                  Fill="{DynamicResource PrimaryBrush}"
                                  Width="22" Height="22" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{svc:Localize Home_AudioTranslation}"
                                       FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="{Binding AudioStatusText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />

                        <Grid Grid.Row="2">
                            <Button Command="{Binding ToggleAudioTranslationCommand}"
                                    Content="{svc:Localize Home_AudioStart}"
                                    Height="38" FontSize="14" HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAudioActive}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding ToggleAudioTranslationCommand}"
                                    Height="38" FontSize="14" HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ButtonDanger}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAudioActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{svc:Localize Home_AudioStop}" VerticalAlignment="Center" />
                                    <Path Data="M6,6H18V18H6V6Z" Fill="White"
                                          Width="12" Height="12" Stretch="Uniform"
                                          VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="3" Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AudioValidationIssues.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ItemsControl ItemsSource="{Binding AudioValidationIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <Path DockPanel.Dock="Left"
                                                  Data="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"
                                                  Fill="{DynamicResource DangerBrush}"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  VerticalAlignment="Top" Margin="0,2,8,0" />
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       TextWrapping="Wrap" FontSize="12" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{svc:Localize Validation_OpenSettings}"
                                    Command="{Binding OpenSettingsFromValidationCommand}"
                                    CommandParameter="audio"
                                    Height="28" FontSize="12" HorizontalAlignment="Stretch"
                                    Margin="0,4,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Text="{Binding AudioToggleHotKeyHint}"
                                   Foreground="{DynamicResource ThirdlyTextBrush}"
                                   FontSize="11" HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
