<UserControl x:Class="GhostLang.WPF.Views.DebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:svc="clr-namespace:GhostLang.WPF.Services"
             xmlns:controls="clr-namespace:GhostLang.WPF.Controls"
             xmlns:conv="clr-namespace:GhostLang.WPF.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <TabControl BorderThickness="0">
        <TabItem Header="{svc:Localize Debug_PipelineOcr}">
            <Grid Margin="10">
                <Grid.Resources>
                    <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,10"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="6" Padding="10,8">
                    <DockPanel>
                        
                        <hc:ButtonGroup DockPanel.Dock="Left" Margin="0,0,8,0">
                            <Button Content="{svc:Localize Debug_LoadImage}"
                                    Command="{Binding LoadImageCommand}" Padding="8,0" />
                            <Button Content="{svc:Localize Debug_SelectRegion}"
                                    Command="{Binding CaptureRegionCommand}" Padding="8,0" />
                            <Button Command="{Binding ProcessImageCommand}"
                                    Style="{StaticResource ButtonPrimary}" Padding="8,0">
                                <StackPanel Orientation="Horizontal">
                                    <hc:LoadingCircle Width="14" Height="14" Margin="0,0,6,0"
                                                      Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
                                                      Foreground="White" />
                                    <TextBlock Text="{svc:Localize Debug_Process}" />
                                </StackPanel>
                            </Button>
                            <Button Content="{svc:Localize Debug_RefreshConfig}"
                                    Command="{Binding LoadCurrentConfigurationCommand}" Padding="8,0" />
                        </hc:ButtonGroup>

                        <hc:Divider Orientation="Vertical" Margin="4,0,8,0" />

                        <controls:LanguageMultiSelect DockPanel.Dock="Left"
                            ItemsSource="{Binding SourceLanguages}"
                            Placeholder="{Binding [Home_SourceLanguagesPlaceholder], Source={x:Static svc:LocalizationService.Instance}}"
                            Width="150" Margin="0,0,8,0" />

                        <ComboBox DockPanel.Dock="Left"
                                  ItemsSource="{Binding TargetLanguages}"
                                  SelectedItem="{Binding SelectedTargetLanguage}" Width="145"
                                  hc:InfoElement.Title="{Binding [Debug_TargetLanguage], Source={x:Static svc:LocalizationService.Instance}}"
                                  hc:InfoElement.TitlePlacement="Left" />
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <TabControl BorderThickness="0">
                        
                        <TabItem Header="{svc:Localize Debug_TabOriginal}">
                            <hc:ImageViewer ImageSource="{Binding OriginalImageSource, Mode=OneWay}"
                                            ShowImgMap="True" ShowToolBar="False" />
                        </TabItem>

                        <TabItem Header="{svc:Localize Debug_TabPreprocessed}">
                            <hc:ImageViewer ImageSource="{Binding PreprocessedImageSource, Mode=OneWay}"
                                            ShowImgMap="True" ShowToolBar="False" />
                        </TabItem>

                        <TabItem Header="{svc:Localize Debug_TabResult}">
                            <hc:ImageViewer ImageSource="{Binding ResultImageSource, Mode=OneWay}"
                                            ShowImgMap="True" ShowToolBar="False" />
                        </TabItem>
                    </TabControl>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,4,8,0"
                            Command="{Binding ToggleImageExpandedCommand}"
                            Padding="6,3" FontSize="12" Cursor="Hand"
                            Style="{StaticResource ButtonDefault}">
                        <TextBlock Text="⛶" />
                    </Button>
                </Grid>

                <Grid Grid.Row="2" Height="190">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="{svc:Localize Debug_Metrics}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold" FontSize="14"
                                           VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        Command="{Binding ToggleMetricsExpandedCommand}"
                                        Padding="6,3" FontSize="12" Cursor="Hand"
                                        Style="{StaticResource ButtonDefault}">
                                    <hc:StatusSwitchElement.CheckedElement>
                                        <TextBlock Text="⮌" />
                                    </hc:StatusSwitchElement.CheckedElement>
                                    <TextBlock Text="⛶" />
                                </Button>
                            </DockPanel>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding PipelineMetrics}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      CanUserResizeColumns="False"
                                      CanUserReorderColumns="False"
                                      CanUserSortColumns="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      RowBackground="Transparent"
                                      FontSize="12"
                                      ScrollViewer.CanContentScroll="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding [Debug_StepLabel], Source={x:Static svc:LocalizationService.Instance}}"
                                                        Binding="{Binding StepName}" Width="*" />
                                    <DataGridTextColumn Header="{Binding [Debug_TimeLabel], Source={x:Static svc:LocalizationService.Instance}}"
                                                        Binding="{Binding ElapsedMilliseconds, StringFormat='{}{0} ms'}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElapsedMilliseconds}" Value="0">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="{svc:Localize Debug_Configuration}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold" FontSize="14"
                                           VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        Command="{Binding ToggleConfigExpandedCommand}"
                                        Padding="6,3" FontSize="12" Cursor="Hand"
                                        Style="{StaticResource ButtonDefault}">
                                    <TextBlock Text="⛶" />
                                </Button>
                            </DockPanel>
                            <TextBox Grid.Row="1" Text="{Binding PipelineInfo, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11"
                                     Background="Transparent"
                                     BorderThickness="0" Padding="4" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="0" Grid.RowSpan="3"
                      Visibility="{Binding IsImageExpanded, Converter={StaticResource BoolToVis}}">
                    <TabControl BorderThickness="0">
                        
                        <TabItem Header="{svc:Localize Debug_TabOriginal}">
                            <hc:ImageViewer ImageSource="{Binding OriginalImageSource, Mode=OneWay}"
                                            ShowImgMap="True" ShowToolBar="False" />
                        </TabItem>

                        <TabItem Header="{svc:Localize Debug_TabPreprocessed}">
                            <hc:ImageViewer ImageSource="{Binding PreprocessedImageSource, Mode=OneWay}"
                                            ShowImgMap="True" ShowToolBar="False" />
                        </TabItem>

                        <TabItem Header="{svc:Localize Debug_TabResult}">
                            <hc:ImageViewer ImageSource="{Binding ResultImageSource, Mode=OneWay}"
                                            ShowImgMap="True" ShowToolBar="False" />
                        </TabItem>
                    </TabControl>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,4,8,0"
                            Command="{Binding ToggleImageExpandedCommand}"
                            Padding="8,4" FontSize="12" Cursor="Hand"
                            Style="{StaticResource ButtonDefault}">
                        <TextBlock Text="⮌" />
                    </Button>
                </Grid>

                <Border Grid.Row="0" Grid.RowSpan="3"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="8" Padding="16"
                        Visibility="{Binding IsMetricsExpanded, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{svc:Localize Debug_Metrics}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="SemiBold" FontSize="16"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Command="{Binding ToggleMetricsExpandedCommand}"
                                    Padding="8,4" FontSize="12" Cursor="Hand"
                                    Style="{StaticResource ButtonDefault}">
                                <TextBlock Text="⮌" />
                            </Button>
                        </DockPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding PipelineMetrics}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  CanUserResizeColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowBackground="Transparent"
                                  FontSize="13"
                                  ScrollViewer.CanContentScroll="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{Binding [Debug_StepLabel], Source={x:Static svc:LocalizationService.Instance}}"
                                                    Binding="{Binding StepName}" Width="*" />
                                <DataGridTextColumn Header="{Binding [Debug_TimeLabel], Source={x:Static svc:LocalizationService.Instance}}"
                                                    Binding="{Binding ElapsedMilliseconds, StringFormat='{}{0} ms'}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElapsedMilliseconds}" Value="0">
                                                    <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.RowSpan="3"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="8" Padding="16"
                        Visibility="{Binding IsConfigExpanded, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{svc:Localize Debug_Configuration}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="SemiBold" FontSize="16"
                                       VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Command="{Binding ToggleConfigExpandedCommand}"
                                    Padding="8,4" FontSize="12" Cursor="Hand"
                                    Style="{StaticResource ButtonDefault}">
                                <TextBlock Text="⮌" />
                            </Button>
                        </DockPanel>
                        <TextBox Grid.Row="1" Text="{Binding PipelineInfo, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12"
                                 Background="Transparent"
                                 BorderThickness="0" Padding="6" />
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="{svc:Localize Settings_TabAudio}">
            <Grid Margin="20">
                <Grid.Resources>
                    <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
                </Grid.Resources>

                <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="8" Padding="24"
                        VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="560">
                    <StackPanel>
                        <TextBlock Text="{svc:Localize Debug_AudioSmokeTestTitle}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{svc:Localize Debug_AudioSmokeTestHint}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{svc:Localize Home_SourceLanguages}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" Width="100"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <controls:LanguageMultiSelect
                                ItemsSource="{Binding SourceLanguages}"
                                Placeholder="{Binding [Home_SourceLanguagesPlaceholder], Source={x:Static svc:LocalizationService.Instance}}"
                                Width="220" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{svc:Localize Home_TargetLanguage}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" Width="100"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <ComboBox ItemsSource="{Binding TargetLanguages}"
                                      SelectedItem="{Binding SelectedTargetLanguage}"
                                      Width="220" Height="30" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{svc:Localize Debug_AudioSource}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" Width="100"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <ComboBox ItemsSource="{Binding AudioSources}"
                                      SelectedItem="{Binding SelectedAudioSource}"
                                      Width="220" Height="30" />
                        </StackPanel>

                        <Button Command="{Binding RecordAudioTestCommand}"
                                Style="{StaticResource ButtonPrimary}"
                                Height="36" Padding="16,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <hc:LoadingCircle Width="14" Height="14" Margin="0,0,8,0"
                                                  Visibility="{Binding IsAudioRecording, Converter={StaticResource BoolToVis}}"
                                                  Foreground="White" />
                                <TextBlock Text="{svc:Localize Debug_AudioRecord}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding AudioTestResultText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"
                                   Visibility="{Binding HasAudioTestResult, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
