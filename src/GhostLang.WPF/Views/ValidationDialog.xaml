<hc:Window x:Class="GhostLang.WPF.Views.ValidationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:svc="clr-namespace:GhostLang.WPF.Services"
        Title="{Binding [Validation_Title], Source={x:Static svc:LocalizationService.Instance}}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="480"
        Background="{DynamicResource RegionBrush}"
        ShowTitle="True">

    <StackPanel Margin="24,16,24,24">
        
        <DockPanel Margin="0,0,0,16">
            <Path DockPanel.Dock="Left"
                  Data="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16"
                  Fill="{DynamicResource WarningBrush}"
                  Width="24" Height="24" Stretch="Uniform"
                  VerticalAlignment="Top" Margin="0,2,12,0" />
            <TextBlock Text="{Binding [Validation_Description], Source={x:Static svc:LocalizationService.Instance}}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" FontSize="13"
                       VerticalAlignment="Center" />
        </DockPanel>

        <ItemsControl x:Name="IssuesList" Margin="0,0,0,20">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                        <DockPanel>
                            <Path DockPanel.Dock="Left"
                                  Data="M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z"
                                  Fill="{DynamicResource DangerBrush}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  VerticalAlignment="Top" Margin="0,1,10,0" />
                            <TextBlock Text="{Binding}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap" FontSize="13" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding [Validation_OpenSettings], Source={x:Static svc:LocalizationService.Instance}}"
                    Style="{StaticResource ButtonPrimary}"
                    Click="OpenSettings_Click"
                    Height="32" Padding="16,0" Margin="0,0,10,0" />
            <Button Content="{Binding [Validation_Close], Source={x:Static svc:LocalizationService.Instance}}"
                    Click="Close_Click"
                    Height="32" Padding="16,0" />
        </StackPanel>
    </StackPanel>
</hc:Window>